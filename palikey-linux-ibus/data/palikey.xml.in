            <language>pi</language>
            <license>MIT</license>
            <author>Giac Ngo &lt;info@giacngo.org&gt;</author>
            <icon>@CMAKE_INSTALL_FULL_DATADIR@/icons/hicolor/scalable/apps/palikey.svg</icon>
