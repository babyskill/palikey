c =====================================================================
c PaliKey — Cross-platform Pāḷi Keyboard for Keyman
c Auto-generated from shared/schemes.json by generate_kmn.py.
c Do not edit this file directly; edit schemes.rs / schemes.json instead.
c
c Supports both PaliTelex and Velthuis input conventions converging to
c identical Unicode output.
c =====================================================================

store(&NAME) 'PaliKey'
store(&KEYBOARDVERSION) '0.1.0'
store(&COPYRIGHT) 'MIT License'
store(&MESSAGE) 'Cross-platform Pāḷi input method supporting PaliTelex and Velthuis conventions.'
store(&TARGETS) 'any'
store(&BITMAP) 'palikey.ico'
store(&VISUALKEYBOARD) 'palikey.kvks'

begin Unicode > use(main)

group(main) using keys

c ---------------------------------------------------------------------
c 1. VOWEL DOUBLING (PaliTelex & Velthuis shared: aa->ā, ii->ī, uu->ū)
c ---------------------------------------------------------------------
store(vowel_ctx) 'a' 'A' 'A' 'i' 'I' 'I' 'u' 'U' 'U' 'e' 'E' 'E' 'o' 'O' 'O'
store(vowel_key) 'a' 'a' 'A' 'i' 'i' 'I' 'u' 'u' 'U' 'e' 'e' 'E' 'o' 'o' 'O'
store(vowel_out) U+0101 U+0100 U+0100 U+012B U+012A U+012A U+016B U+016A U+016A U+0113 U+0112 U+0112 U+014D U+014C U+014C
any(vowel_ctx) + any(vowel_key) > index(vowel_out, 1)

c ---------------------------------------------------------------------
c 2. VELTHUIS PREFIX RULES (.t->ṭ, .d->ḍ, .n->ṇ, .m->ṃ, "n->ṅ, ~n->ñ)
c ---------------------------------------------------------------------
store(velthuis2_pfx) '.' '.' '.' '.' '.' '.' '.' '.' '.' '.' U+0022 U+0022 '~' '~' '.' '.' '.' '.' U+0022 U+0022 '.' '.'
store(velthuis2_key) 't' 'T' 'd' 'D' 'n' 'N' 'm' 'M' 'l' 'L' 'n' 'N' 'n' 'N' 'r' 'R' 'h' 'H' 's' 'S' 's' 'S'
store(velthuis2_out) U+1E6D U+1E6C U+1E0D U+1E0C U+1E47 U+1E46 U+1E43 U+1E42 U+1E37 U+1E36 U+1E45 U+1E44 U+00F1 U+00D1 U+1E5B U+1E5A U+1E25 U+1E24 U+015B U+015A U+1E63 U+1E62
any(velthuis2_pfx) + any(velthuis2_key) > index(velthuis2_out, 1)

c ---------------------------------------------------------------------
c 3. VELTHUIS 3-CHAR EXTENDED RULES (.rr->ṝ, .ll->ḹ)
c ---------------------------------------------------------------------
store(velthuis3_c1)  '.' '.' '.' '.' '.' '.'
store(velthuis3_c2)  'r' 'R' 'R' 'l' 'L' 'L'
store(velthuis3_key) 'r' 'r' 'R' 'l' 'l' 'L'
store(velthuis3_out) U+1E5D U+1E5C U+1E5C U+1E39 U+1E38 U+1E38
any(velthuis3_c1) any(velthuis3_c2) + any(velthuis3_key) > index(velthuis3_out, 1)

c ---------------------------------------------------------------------
c 4. PALITELEX SUFFIX RULES (tx->ṭ, dx->ḍ, nx->ṇ, mx->ṃ, lx->ḷ, nw->ñ)
c ---------------------------------------------------------------------
store(telex2_ctx) 't' 'T' 'T' 'd' 'D' 'D' 'n' 'N' 'N' 'm' 'M' 'M' 'l' 'L' 'L' 'n' 'N' 'N' 'n' 'N' 'N' 'r' 'R' 'R' 'h' 'H' 'H' 's' 'S' 'S' 's' 'S' 'S'
store(telex2_key) 'x' 'x' 'X' 'x' 'x' 'X' 'x' 'x' 'X' 'x' 'x' 'X' 'x' 'x' 'X' 'w' 'w' 'W' 'y' 'y' 'Y' 'x' 'x' 'X' 'x' 'x' 'X' 'x' 'x' 'X' 'w' 'w' 'W'
store(telex2_out) U+1E6D U+1E6C U+1E6C U+1E0D U+1E0C U+1E0C U+1E47 U+1E46 U+1E46 U+1E43 U+1E42 U+1E42 U+1E37 U+1E36 U+1E36 U+00F1 U+00D1 U+00D1 U+00F1 U+00D1 U+00D1 U+1E5B U+1E5A U+1E5A U+1E25 U+1E24 U+1E24 U+1E63 U+1E62 U+1E62 U+015B U+015A U+015A
any(telex2_ctx) + any(telex2_key) > index(telex2_out, 1)

c ---------------------------------------------------------------------
c 5. PALITELEX 3-CHAR RULES (ngw->ṅ, ngx->ṅ, rrx->ṝ, llx->ḹ)
c ---------------------------------------------------------------------
store(telex3_c1)  'n' 'N' 'N' 'n' 'N' 'N' 'r' 'R' 'R' 'l' 'L' 'L'
store(telex3_c2)  'g' 'g' 'G' 'g' 'g' 'G' 'r' 'r' 'R' 'l' 'l' 'L'
store(telex3_key) 'w' 'w' 'W' 'x' 'x' 'X' 'x' 'x' 'X' 'x' 'x' 'X'
store(telex3_out) U+1E45 U+1E44 U+1E44 U+1E45 U+1E44 U+1E44 U+1E5D U+1E5C U+1E5C U+1E39 U+1E38 U+1E38
any(telex3_c1) any(telex3_c2) + any(telex3_key) > index(telex3_out, 1)

c ---------------------------------------------------------------------
c 6. REPEAT-KEY ESCAPE (Undo composition if trigger key is repeated)
c ---------------------------------------------------------------------
store(v_undo_ctx) U+0101 U+0100 U+0100 U+012B U+012A U+012A U+016B U+016A U+016A U+0113 U+0112 U+0112 U+014D U+014C U+014C
store(v_undo_key) 'a' 'a' 'A' 'i' 'i' 'I' 'u' 'u' 'U' 'e' 'e' 'E' 'o' 'o' 'O'
store(v_undo_out) 'aaa' 'Aaa' 'AAA' 'iii' 'Iii' 'III' 'uuu' 'Uuu' 'UUU' 'eee' 'Eee' 'EEE' 'ooo' 'Ooo' 'OOO'
any(v_undo_ctx) + any(v_undo_key) > index(v_undo_out, 1)

store(t2_undo_ctx) U+1E6D U+1E6C U+1E6C U+1E0D U+1E0C U+1E0C U+1E47 U+1E46 U+1E46 U+1E43 U+1E42 U+1E42 U+1E37 U+1E36 U+1E36 U+00F1 U+00D1 U+00D1 U+00F1 U+00D1 U+00D1 U+1E5B U+1E5A U+1E5A U+1E25 U+1E24 U+1E24 U+1E63 U+1E62 U+1E62 U+015B U+015A U+015A
store(t2_undo_key) 'x' 'x' 'X' 'x' 'x' 'X' 'x' 'x' 'X' 'x' 'x' 'X' 'x' 'x' 'X' 'w' 'w' 'W' 'y' 'y' 'Y' 'x' 'x' 'X' 'x' 'x' 'X' 'x' 'x' 'X' 'w' 'w' 'W'
store(t2_undo_out) 'txx' 'Txx' 'TXX' 'dxx' 'Dxx' 'DXX' 'nxx' 'Nxx' 'NXX' 'mxx' 'Mxx' 'MXX' 'lxx' 'Lxx' 'LXX' 'nww' 'Nww' 'NWW' 'nyy' 'Nyy' 'NYY' 'rxx' 'Rxx' 'RXX' 'hxx' 'Hxx' 'HXX' 'sxx' 'Sxx' 'SXX' 'sww' 'Sww' 'SWW'
any(t2_undo_ctx) + any(t2_undo_key) > index(t2_undo_out, 1)

store(t3_undo_ctx) U+1E45 U+1E44 U+1E44 U+1E45 U+1E44 U+1E44 U+1E5D U+1E5C U+1E5C U+1E39 U+1E38 U+1E38
store(t3_undo_key) 'w' 'w' 'W' 'x' 'x' 'X' 'x' 'x' 'X' 'x' 'x' 'X'
store(t3_undo_out) 'ngww' 'Ngww' 'NGWW' 'ngxx' 'Ngxx' 'NGXX' 'rrxx' 'Rrxx' 'RRXX' 'llxx' 'Llxx' 'LLXX'
any(t3_undo_ctx) + any(t3_undo_key) > index(t3_undo_out, 1)

c ---------------------------------------------------------------------
c 7. PREFIX ESCAPES (Double-tap prefix outputs literal character)
c ---------------------------------------------------------------------
'.' + '.' > '..'
'"' + '"' > '""'
'~' + '~' > '~~'
'\' + '\' > '\\'

